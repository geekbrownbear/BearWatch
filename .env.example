# Copy to .env and fill in. Never commit .env.

# python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
BEARWATCH_API_TOKEN=

# Optional. Free key from https://nvd.nist.gov/developers/request-an-api-key
# Raises the rate limit (5 -> 50 requests per 30 s). The first full NVD sync takes ~75 minutes
# without a key and ~50 with one; most of that is NVD generating each 2,000-CVE page.
BEARWATCH_NVD_API_KEY=

# Optional. Free community account at https://vulncheck.com adds VulnCheck KEV.
BEARWATCH_VULNCHECK_API_TOKEN=

# Months of Microsoft CVRF documents to keep (each ~30 MB to download).
BEARWATCH_MSRC_MONTHS=36

# Dashboard sign-in in production: Cloudflare Access. Team domain is
# <team>.cloudflareaccess.com; the AUD tag is on the Access application's overview page.
# Local development (compose.override.yaml) signs in with BEARWATCH_API_TOKEN instead.
BEARWATCH_CF_ACCESS_TEAM_DOMAIN=
BEARWATCH_CF_ACCESS_AUD=
