{
  "_about": "Maps a Windows program (Uninstall registry DisplayName, optional Publisher) to the NVD CPE vendor/product used for CVE matching, and to a WinGet package id for the fix. Rules are tried in order and the first match wins, so put specific rules (Firefox ESR) before general ones (Firefox). name and publisher are case-insensitive regular expressions. Format idea credited to Fleet's cpe_translations.json (MIT). Run `bearwatch overrides check` after an NVD sync to find rules whose vendor/product has no CVE data.",
  "rules": [
    {"name": "^Google Chrome$", "cpe": [["google", "chrome"]], "winget": "Google.Chrome"},
    {"name": "^Mozilla Firefox ESR\\b", "cpe": [["mozilla", "firefox_esr"]], "winget": "Mozilla.Firefox.ESR"},
    {"name": "^Mozilla Firefox\\b", "cpe": [["mozilla", "firefox"]], "winget": "Mozilla.Firefox"},
    {"name": "^Mozilla Thunderbird\\b", "cpe": [["mozilla", "thunderbird"]], "winget": "Mozilla.Thunderbird"},
    {"name": "^Microsoft Edge$", "cpe": [["microsoft", "edge_chromium"]], "winget": "Microsoft.Edge"},
    {"name": "^7-Zip\\b", "cpe": [["7-zip", "7-zip"]], "winget": "7zip.7zip"},
    {"name": "^Notepad\\+\\+", "cpe": [["notepad-plus-plus", "notepad\\+\\+"]], "winget": "Notepad++.Notepad++"},
    {"name": "^Adobe Acrobat Reader\\b|^Adobe Acrobat Reader DC\\b", "cpe": [["adobe", "acrobat_reader_dc"], ["adobe", "acrobat_reader"]], "winget": "Adobe.Acrobat.Reader.64-bit"},
    {"name": "^Adobe Acrobat( \\(64-bit\\)| DC)?$", "cpe": [["adobe", "acrobat_dc"], ["adobe", "acrobat"]], "winget": null},
    {"name": "^VLC media player$", "cpe": [["videolan", "vlc_media_player"]], "winget": "VideoLAN.VLC"},
    {"name": "^Zoom( Workplace)?\\b", "publisher": "Zoom", "cpe": [["zoom", "workplace_desktop"], ["zoom", "meetings"], ["zoom", "zoom"]], "winget": "Zoom.Zoom"},
    {"name": "^PuTTY\\b", "cpe": [["putty", "putty"], ["simon_tatham", "putty"]], "winget": "PuTTY.PuTTY"},
    {"name": "^WinRAR\\b", "cpe": [["rarlab", "winrar"]], "winget": "RARLab.WinRAR"},
    {"name": "^WinSCP\\b", "cpe": [["winscp", "winscp"]], "winget": "WinSCP.WinSCP"},
    {"name": "^FileZilla( Client)?\\b", "cpe": [["filezilla-project", "filezilla_client"]], "winget": "TimKosse.FileZilla.Client"},
    {"name": "^Wireshark\\b", "cpe": [["wireshark", "wireshark"]], "winget": "WiresharkFoundation.Wireshark"},
    {"name": "^TeamViewer\\b", "cpe": [["teamviewer", "teamviewer"]], "winget": "TeamViewer.TeamViewer"},
    {"name": "^AnyDesk\\b", "cpe": [["anydesk", "anydesk"]], "winget": "AnyDesk.AnyDesk"},
    {"name": "^KeePass Password Safe\\b", "cpe": [["keepass", "keepass"]], "winget": "DominikReichl.KeePass"},
    {"name": "^Git$|^Git version\\b", "publisher": "Git|Johannes", "cpe": [["git-scm", "git"]], "winget": "Git.Git"},
    {"name": "^Python 3\\.\\d+\\.\\d+", "publisher": "Python Software Foundation", "cpe": [["python", "python"]], "winget": null},
    {"name": "^Node\\.js$", "cpe": [["nodejs", "node.js"]], "winget": "OpenJS.NodeJS"},
    {"name": "^Microsoft Visual Studio Code\\b", "cpe": [["microsoft", "visual_studio_code"]], "winget": "Microsoft.VisualStudioCode"},
    {"name": "^Oracle VM VirtualBox\\b|^Oracle VirtualBox\\b", "cpe": [["oracle", "vm_virtualbox"]], "winget": "Oracle.VirtualBox"},
    {"name": "^OpenVPN \\d", "cpe": [["openvpn", "openvpn"]], "winget": null},
    {"name": "^Foxit PDF Reader\\b|^Foxit Reader\\b", "cpe": [["foxit", "pdf_reader"]], "winget": "Foxit.FoxitReader"},
    {"name": "^Citrix Workspace\\b", "cpe": [["citrix", "workspace"]], "winget": "Citrix.Workspace"},
    {"name": "^iTunes$", "publisher": "Apple", "cpe": [["apple", "itunes"]], "winget": "Apple.iTunes"},
    {"name": "^LibreOffice\\b", "cpe": [["libreoffice", "libreoffice"]], "winget": "TheDocumentFoundation.LibreOffice"},
    {"name": "^GIMP\\b", "cpe": [["gimp", "gimp"]], "winget": "GIMP.GIMP"},
    {"name": "^PostgreSQL \\d", "cpe": [["postgresql", "postgresql"]], "winget": null},
    {"name": "^MySQL Server\\b", "cpe": [["oracle", "mysql"]], "winget": null},
    {"name": "^Greenshot\\b", "cpe": [["getgreenshot", "greenshot"]], "winget": "Greenshot.Greenshot"}
  ]
}
